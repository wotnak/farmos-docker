# Keep this project name stable so updates reuse the same data volumes.
COMPOSE_PROJECT_NAME=farmos-contrib
# Local HTTP or external proxy:
COMPOSE_FILE=compose.yaml
# For automatic public HTTPS, use compose.yaml:compose.https.yaml instead.
# Append :compose.egress.yaml to allow outbound traffic from cron.

# Generate a database password, for example: openssl rand -hex 32
# These Compose examples include PostgreSQL. See README.md for other drivers.
FARMOS_DB_DRIVER=pgsql
FARMOS_DB_HOST=db
# Empty selects the PostgreSQL default, 5432.
FARMOS_DB_PORT=
FARMOS_DB_PASS=
FARMOS_DB_NAME=farmos
FARMOS_DB_USER=farm
# Optional override, at least 32 characters. Empty generates a persistent salt in private_files.
FARMOS_HASH_SALT=
FARMOS_BIND_ADDRESS=127.0.0.1
FARMOS_PORT=8080
# Set a public hostname for a reverse proxy or the compose.https.yaml overlay.
FARMOS_DOMAIN=localhost
FARMOS_AUTO_HTTPS=false
# Empty uses FARMOS_DOMAIN (and loopback hosts when the domain is localhost).
FARMOS_TRUSTED_HOSTS=
# Comma-separated proxy IP addresses or CIDRs. Empty means no trusted proxies.
FARMOS_TRUSTED_PROXIES=
# Matching source, Composer builder, and final runtime. Pin published digests.
FARMOS_BASE_IMAGE=ghcr.io/wotnak/farmos:4
FARMOS_BUILD_IMAGE=ghcr.io/wotnak/farmos:4-dev-runtime
FARMOS_RUNTIME_IMAGE=ghcr.io/wotnak/farmos:4-runtime
FARMOS_CRON_INTERVAL=900

# Used by compose.https.yaml; ports 80/443 must be reachable for public certificates.
FARMOS_HTTPS_BIND_ADDRESS=0.0.0.0
FARMOS_HTTP_PORT=80
FARMOS_HTTPS_PORT=443
