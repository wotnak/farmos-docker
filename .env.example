# Task loads these build settings from the root .env using native dotenv support.
# Process environment values take precedence. Python scripts need exported values
# or an explicit configuration JSON file. Deployment examples use separate .env files.
# These two settings are required. Composer resolves the constraint at build time.
FARMOS_VERSION=^4.0
FARMOS_IMAGE_TAG=4

# Optional container repository. Default: ghcr.io/wotnak/farmos.
# FARMOS_IMAGE_NAME=ghcr.io/wotnak/farmos

# Optional Composer repository. Unset or empty uses the normal repositories.
# A custom JSON object is prepended; Drupal and Packagist remain available.
# FARMOS_REPOSITORY=
# FARMOS_REPOSITORY='{"type":"vcs","url":"https://github.com/YOUR-ORG/farmOS"}'

# Optional variants. Unset or empty builds every variant.
# Names: production,development,runtime,development-runtime
# FARMOS_IMAGE_VARIANTS=
# Example subset: FARMOS_IMAGE_VARIANTS=production,runtime

# Development-only example: FARMOS_VERSION=4.x-dev, FARMOS_IMAGE_TAG=4.x,
# FARMOS_IMAGE_VARIANTS=development. The resulting tag is 4.x-dev.
