#!/usr/bin/env bash
# Publish a signed candidate index. promote-images owns public tag changes.
set -euo pipefail

output=${1:?Usage: publish-index NIX_OUTPUT CHILDREN_DIR EVIDENCE_DIR}
children=${2:?Missing architecture evidence directory}
evidence=${3:?Missing index evidence directory}
: "${GITHUB_REPOSITORY:?}" "${GITHUB_RUN_ID:?}" "${GITHUB_RUN_ATTEMPT:?}"
: "${SOURCE_REVISION:?}" "${DEFAULT_BRANCH:?}"
repository=${IMAGE_REPOSITORY:-ghcr.io/wotnak/farmos}
mkdir -p "$evidence"

# A failed validator must stop publication, including on retries with older artifacts.
python3 scripts/image_evidence.py validate-children --children "$children" \
  --output "$output" --identity-directory "$evidence/expected-children" > "$evidence/children.txt"
mapfile -t sources < "$evidence/children.txt"
for image in "${sources[@]}"; do
  # Keep the registry digest intact; only filesystem paths need a safe separator.
  digest=${image##*@}
  digest_path=${digest/:/-}
  scripts/attest-image verify "$image" "$evidence/$digest_path" architecture \
    "$evidence/expected-children/$digest_path.json"
done

source_url=$(python3 -c 'import json; print(json.load(open("images/source.json"))["source"])')
candidate="${repository}:index-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}-${output}"
docker buildx imagetools create --tag "$candidate" \
  --annotation "index:org.opencontainers.image.source=${source_url}" \
  --annotation "index:org.opencontainers.image.revision=${SOURCE_REVISION}" \
  --metadata-file "$evidence/index-metadata.json" "${sources[@]}"
digest=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["containerimage.descriptor"]["digest"])' "$evidence/index-metadata.json")
image="${repository}@${digest}"
python3 scripts/image_evidence.py index --image "$image" --output "$output" \
  --children "$children" --destination "$evidence"
scripts/attest-image sign "$image" "$evidence" index

printf '%s\n' "$image" > "$evidence/candidate-image.txt"
