#!/usr/bin/env bash
# Sign immutable images and publish signed predicates. Requires GitHub OIDC.
set -euo pipefail

mode=${1:?Usage: attest-image sign|verify IMAGE EVIDENCE_DIR [architecture|index] [EXPECTED_IDENTITY_JSON]}
image=${2:?Missing immutable image reference}
evidence=${3:?Missing evidence directory}
kind=${4:-architecture}
if [[ "$mode" == verify ]]; then
  expected_identity=${5:?Verification requires the validated expected identity JSON}
else
  expected_identity=${5:-$evidence/identity.json}
fi
: "${SIGNING_IDENTITY:?Expected GitHub workflow certificate identity is required}"
[[ "$image" =~ @sha256:[0-9a-f]{64}$ ]] || { echo "Expected an image digest" >&2; exit 1; }
[[ "$kind" == architecture || "$kind" == index ]] || exit 1
[[ "$mode" == sign || "$mode" == verify ]] || exit 1
mkdir -p "$evidence"

if [[ "$mode" == sign ]]; then
  cosign sign --yes --bundle "$evidence/signature.sigstore.json" "$image"
  cosign attest --yes --type slsaprovenance1 \
    --predicate "$evidence/provenance.json" \
    --bundle "$evidence/provenance.sigstore.json" "$image"
fi

identity=(--certificate-identity "$SIGNING_IDENTITY"
  --certificate-oidc-issuer https://token.actions.githubusercontent.com)
cosign verify "${identity[@]}" "$image" > "$evidence/verified-signature.json"
cosign verify-attestation "${identity[@]}" --type slsaprovenance1 \
  "$image" > "$evidence/verified-provenance.json"

python3 scripts/image_evidence.py verify-attestation \
  --image "$image" --kind "$kind" --identity "$expected_identity" \
  --attestations "$evidence/verified-provenance.json"
