#!/usr/bin/env python3
"""Prepare one Composer configuration and fresh Nix inputs for this build."""

import argparse
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parent))
from build_config import PROFILE_KEYS, load, normalize
from nix_source import snapshot


HASH = re.compile(r"^\s*got:\s*(sha256-[A-Za-z0-9+/]{43}=)\s*$", re.MULTILINE)


class PreparationError(ValueError):
    """Fresh build input preparation failed."""


class Nix:
    def __init__(self, root):
        self.root = root
        self.command = [os.environ.get("NIX", "nix")]
        self.command += shlex.split(os.environ.get("NIX_FLAGS", '--extra-experimental-features "nix-command flakes"'))
        self.system = os.environ.get("NIX_SYSTEM")

    def run(self, *args):
        return subprocess.run(self.command + list(args), cwd=self.root, text=True, capture_output=True)

    def checked(self, *args):
        result = self.run(*args)
        if result.returncode:
            raise PreparationError(result.stderr.strip() or result.stdout.strip() or "Nix command failed")
        return result.stdout.strip()

    def build(self, *args):
        # Explicit path flakes include ignored generated inputs without changing
        # the checkout's Git index. Copy only the files needed by the flake.
        if any(arg.startswith('.#') for arg in args):
            source = 'path:' + str(snapshot(self.root))
            args = tuple(source + arg[1:] if arg.startswith('.#') else arg for arg in args)
        command = ["build", *args, "--no-link", "--print-out-paths"]
        if self.system:
            command += ["--system", self.system]
        return self.run(*command)

    def resolver_expression(self, attribute, nonce, output_hash=None):
        system = json.dumps(self.system) if self.system else "builtins.currentSystem"
        overrides = f'pname = old.pname + "-prepare-{nonce}";'
        if output_hash is not None:
            overrides += f" outputHash = {json.dumps(output_hash)};"
        source = 'path:' + str(snapshot(self.root))
        return (f"let flake = builtins.getFlake {json.dumps(source)}; "
                f"in flake.packages.${{{system}}}.{json.dumps(attribute)}.resolveDependencies"
                f".overrideAttrs (old: {{ {overrides} }})")


def actual_hash(result):
    matches = HASH.findall(result.stderr + "\n" + result.stdout)
    if not matches:
        raise PreparationError(result.stderr.strip() or result.stdout.strip() or "Nix failed without an output hash")
    return matches[-1]


def output_path(result):
    if result.returncode:
        raise PreparationError(result.stderr.strip() or "Nix build failed")
    paths = result.stdout.strip().splitlines()
    if len(paths) != 1 or not Path(paths[0]).is_absolute():
        raise PreparationError("Nix did not return exactly one absolute output path")
    return Path(paths[0])


def write_build(root, data):
    path = root / ".build-inputs/build.json"
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=".build-",
                                         suffix=".json", delete=False) as output:
            temporary = Path(output.name)
            json.dump(data, output, indent=2)
            output.write("\n")
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def locked_release(lock):
    if not isinstance(lock, dict):
        raise PreparationError("Composer lock must contain an object")
    packages = []
    for key in ("packages", "packages-dev"):
        entries = lock.get(key, [])
        if not isinstance(entries, list) or any(not isinstance(entry, dict) for entry in entries):
            raise PreparationError("Composer lock packages must be arrays of objects")
        packages.extend(entries)
    matches = [package for package in packages if package.get("name") == "farmos/farmos"]
    if len(matches) != 1 or not isinstance(matches[0].get("version"), str) or not matches[0]["version"]:
        raise PreparationError("Composer lock must identify exactly one farmos/farmos version")
    resolved = {key: matches[0].get(key) for key in ("version", "source", "dist")}
    if any(resolved[key] is not None and not isinstance(resolved[key], dict) for key in ("source", "dist")):
        raise PreparationError("Locked farmOS source and dist must be objects or null")
    return resolved


def resolve_composer(root, nix):
    attribute = "farmos-dev-app"
    # A unique derivation name forces live dependency resolution even when the
    # configured constraint resolves to the same packages as a previous invocation.
    nonce = uuid.uuid4().hex
    expression = nix.resolver_expression(attribute, nonce)
    result = nix.build("--impure", "--expr", expression)
    if result.returncode:
        resolved_hash = actual_hash(result)
        expression = nix.resolver_expression(attribute, nonce, resolved_hash)
        result = nix.build("--impure", "--expr", expression)
    resolved = output_path(result)
    destination = root / ".build-inputs/composer"
    destination.mkdir(parents=True)
    for name in ("composer.json", "composer.lock"):
        source = resolved / name
        if not isinstance(json.loads(source.read_text()), dict):
            raise PreparationError(f"Resolver returned invalid {name}")
        shutil.copyfile(source, destination / name)
    return locked_release(json.loads((destination / "composer.lock").read_text()))


def prepare_app_hash(root, nix, data, field, attribute):
    print(f"Calculating application output hash for {attribute}...", flush=True)
    result = nix.build(f'.#"{attribute}"')
    if result.returncode:
        value = actual_hash(result)
    else:
        # A substituted output can succeed without a mismatch. Record its hash
        # explicitly rather than leaving the provisional empty value behind.
        value = nix.checked("hash", "path", "--type", "sha256", str(output_path(result)))
        if not re.fullmatch(r"sha256-[A-Za-z0-9+/]{43}=", value):
            raise PreparationError("Nix returned an invalid application output hash")
    data[field] = value
    write_build(root, data)
    # This regular build verifies the calculated hash. No reproducibility rebuild.
    if result.returncode:
        output_path(nix.build(f'.#"{attribute}"'))


def clear_generated(root):
    build = root / "build"
    if build.is_symlink():
        raise PreparationError("Build output directory must not be a symlink")
    source = build / "nix-source"
    if source.is_symlink():
        source.unlink()
    elif source.exists():
        shutil.rmtree(source)
    if (root / ".build-inputs").exists():
        shutil.rmtree(root / ".build-inputs")
    (root / "flake.lock").unlink(missing_ok=True)


def prepare(root, *, configuration=None):
    root = root.resolve()
    if configuration is None:
        profile = load()
    else:
        settings = json.loads(Path(configuration).read_text())
        if not isinstance(settings, dict):
            raise PreparationError("Build configuration must be an object")
        profile = normalize({key: settings[key] for key in PROFILE_KEYS if key in settings})
    lock = root / ".prepare-build.lock"
    try:
        lock.mkdir()
    except FileExistsError:
        raise PreparationError("Another preparation is running, or .prepare-build.lock needs removal after an interrupted run") from None
    try:
        clear_generated(root)
        inputs = root / ".build-inputs"
        inputs.mkdir()
        marker = inputs / ".preparing"
        marker.touch()
        data = {**profile, "resolved": {}, "prodHash": "", "devHash": ""}
        write_build(root, data)
        nix = Nix(root)
        print("Refreshing Nix flake inputs...", flush=True)
        source = snapshot(root)
        nix.checked("flake", "update", "--flake", "path:" + str(source))
        if not (source / "flake.lock").is_file():
            raise PreparationError("Nix did not generate flake.lock")
        shutil.copyfile(source / "flake.lock", root / "flake.lock")
        print("Resolving fresh Composer dependencies...", flush=True)
        data["resolved"] = resolve_composer(root, nix)
        write_build(root, data)
        for variant, field, attribute in [
            ("production", "prodHash", "farmos-app"),
            ("development", "devHash", "farmos-dev-app"),
        ]:
            if variant in profile["variants"]:
                prepare_app_hash(root, nix, data, field, attribute)
        marker.unlink()
        snapshot(root)
        print("Prepared fresh build inputs in .build-inputs/ and flake.lock; Nix source is build/nix-source.", flush=True)
        return data
    except BaseException:
        clear_generated(root)
        raise
    finally:
        lock.rmdir()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--configuration", type=Path,
                        help="Build profile JSON")
    args = parser.parse_args(argv)
    try:
        prepare(Path(__file__).resolve().parent.parent, configuration=args.configuration)
    except (OSError, ValueError, KeyboardInterrupt) as error:
        print(f"Build input preparation failed: {error}. Run scripts/prepare-build again before building.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
