#!/usr/bin/env python3
"""Publish configured multi-platform tags from tested architecture digests."""

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys

import build_config

ROOT = Path(__file__).resolve().parents[1]
DIGEST = re.compile(r"sha256:[0-9a-f]{64}")


def publication(configuration, directory):
    profile = build_config.normalize(configuration)
    commands = []
    # Read every required digest before changing any public tag.
    for variant, image in build_config.tags(profile).items():
        output = build_config.VARIANTS[variant]["output"]
        sources = []
        for architecture in ("amd64", "arm64"):
            digest = (directory / f"{output}-{architecture}.txt").read_text().strip()
            if not DIGEST.fullmatch(digest):
                raise ValueError(f"Invalid digest for {output}/{architecture}")
            sources.append(profile["image-name"] + "@" + digest)
        commands.append(["docker", "buildx", "imagetools", "create", "--tag", image, *sources])
    return commands


def publish(root, commands):
    for command in commands:
        subprocess.run(command, cwd=root, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--configuration", type=Path, default=ROOT / ".build-inputs/build.json")
    parser.add_argument("--digests", type=Path, required=True)
    args = parser.parse_args()
    try:
        publish(ROOT, publication(json.loads(args.configuration.read_text()), args.digests))
    except (ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        print(f"Publication failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
