#!/usr/bin/env bash
# Maintain only the Docker-backed Nix build cache, never application volumes.
set -euo pipefail

action=${1:-info}
case "$action" in
  info|prune) ;;
  *) echo 'Usage: scripts/nix-build-cache [info|prune]' >&2; exit 2 ;;
esac
root=$(cd "$(dirname "$0")/.." && pwd)
volume=${NIX_CACHE_VOLUME:-farmos-nix-build-cache}
builder=${NIX_BUILDER_IMAGE:-nixos/nix:2.31.2}
# Refuse accidental creation of an empty volume after a typo.
docker volume inspect "$volume" >/dev/null
if [ -n "$(docker ps -q --filter "volume=$volume")" ]; then
  echo "Stop builds using $volume before inspecting or pruning it." >&2
  exit 1
fi

outputs=
if [ "$action" = prune ]; then
  outputs=$(python3 "$root/scripts/local_build.py" --root "$root" --prepared cache-plan)
fi

docker run --rm \
  --mount "type=volume,source=$volume,target=/nix" \
  --mount "type=bind,source=$root,target=/work,readonly" \
  --workdir /work -e CACHE_ACTION="$action" -e CACHE_OUTPUTS="$outputs" \
  "$builder" sh -eu -c '
    echo "Nix store before:"
    du -sh /nix/store
    if [ "$CACHE_ACTION" = info ]; then
      echo "Registered persistent roots:"
      nix-store --gc --print-roots | grep -v "^/proc/" || true
      exit 0
    fi
    # Pin only configured variants before collecting old outputs.
    # The image closures include everything required to reload them.
    mkdir -p /nix/var/nix/gcroots/farmos-containers
    set --
    for output in $CACHE_OUTPUTS; do
      set -- "$@" "path:./build/nix-source#$output"
    done
    [ "$#" -gt 0 ] || { echo "No configured images to retain" >&2; exit 1; }
    nix --extra-experimental-features "nix-command flakes" build \
      --out-link /nix/var/nix/gcroots/farmos-containers/current \
      "$@"
    # Retain the small loaders too, so loading an unchanged image does not
    # require rebuilding nix2container or its Skopeo transport.
    set --
    for output in $CACHE_OUTPUTS; do
      set -- "$@" "path:./build/nix-source#$output.copyToDockerDaemon"
    done
    nix --extra-experimental-features "nix-command flakes" build \
      --out-link /nix/var/nix/gcroots/farmos-containers/loader \
      "$@"
    nix-store --gc
    nix-store --optimise
    echo "Nix store after:"
    du -sh /nix/store
  '
